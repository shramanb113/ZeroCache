# Required -- the spine of the demo (coder/architect/fixer chat + text embeddings)
OPENAI_API_KEY=

# Optional -- reviewer falls back to an OpenAI-wire model if unset
ANTHROPIC_API_KEY=

# Optional -- the image-embedding step is skipped if unset
GEMINI_API_KEY=

# Zerocache instance (start with: cargo run -p zerocache-http)
ZEROCACHE_BASE_URL=http://localhost:8080

# Model overrides (defaults shown)
SHOWCASE_CHAT_MODEL=gpt-4o-mini
SHOWCASE_REVIEW_MODEL=claude-sonnet-5
SHOWCASE_EMBED_MODEL=text-embedding-3-small
SHOWCASE_IMAGE_MODEL=gemini-embedding-001
