# === Required ===============================================================
# The spine of the demo: architect / coder / fixer chat calls + text embeddings.
OPENAI_API_KEY=

# Zerocache instance (start it with: cargo run -p zerocache-http)
ZEROCACHE_BASE_URL=http://localhost:8080

# === Recommended ===========================================================
# The reviewer runs on Claude's NATIVE /v1/messages API (not an OpenAI shim),
# streamed and cached. Without this key the reviewer degrades to an OpenAI-wire
# model and the header shows `degraded: anthropic->openai` -- the demo still
# works, but the "provider-neutral, not OpenAI-only" beat is weaker.
ANTHROPIC_API_KEY=

# === Optional: multimodal breadth =========================================
# Adds one `POST /gemini/v1/images/embeddings` call so the run also exercises
# the image-embeddings cache. Off by default -- leave unset for the standard
# two-key run. Set a real key AND drop a real PNG at
# target-repo/docs/architecture.png to enable it.
GEMINI_API_KEY=

# === Model overrides (defaults shown) =====================================
SHOWCASE_CHAT_MODEL=gpt-4o-mini
SHOWCASE_REVIEW_MODEL=claude-sonnet-5
SHOWCASE_EMBED_MODEL=text-embedding-3-small
SHOWCASE_IMAGE_MODEL=gemini-embedding-001

# === Run the whole demo through a non-OpenAI provider =====================
# Every provider below is a built-in Zerocache route -- BYOK, no Zerocache key.
# e.g. Gemini only:  SHOWCASE_API_KEY=<gemini key>
#                    SHOWCASE_CHAT_PROVIDER=gemini  SHOWCASE_EMBED_PROVIDER=gemini
#                    SHOWCASE_CHAT_MODEL=gemini-2.5-flash  SHOWCASE_EMBED_MODEL=gemini-embedding-001
SHOWCASE_API_KEY=
SHOWCASE_CHAT_PROVIDER=openai
SHOWCASE_EMBED_PROVIDER=openai
