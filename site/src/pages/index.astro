---
import BaseLayout from "../layouts/BaseLayout.astro";
import HashStrip from "../components/HashStrip.astro";
import FlowDiagram from "../components/FlowDiagram.astro";
import StatCallout from "../components/StatCallout.astro";
import CodeBlock from "../components/CodeBlock.astro";

// astro.config.mjs sets `base: "/ZeroCache"` with no trailing slash, so
// import.meta.env.BASE_URL is exactly "/ZeroCache" — normalize to always end
// in "/" so link construction below (`${base}benchmarks/`) doesn't produce
// a malformed path like "/ZeroCachebenchmarks/". Same pattern as Nav.astro.
const rawBase = import.meta.env.BASE_URL;
const base = rawBase.endsWith("/") ? rawBase : `${rawBase}/`;

const quickstart = `docker run -p 8080:8080 ghcr.io/shramanb113/zerocache:latest

curl http://localhost:8080/openai/v1/embeddings \\
  -H "Authorization: Bearer $OPENAI_API_KEY" \\
  -H "Content-Type: application/json" \\
  -d '{"model": "text-embedding-3-small", "input": "hello world"}'`;
---

<BaseLayout
  title="Home"
  description="A drop-in, Rust-native embedding cache. Point your OpenAI-compatible client at Zerocache instead of the real provider."
>
  <section class="hero">
    <div class="hero__copy">
      <HashStrip />
      <h1>Stop paying to re-embed text you've already embedded.</h1>
      <p class="hero__sub">
        Zerocache sits between your ingestion pipeline and your embedding provider. It intercepts
        <code>/v1/embeddings</code>, serves identical inputs from a local content-addressed store, and
        forwards only cache misses upstream. No SDK, no framework plugin — point your existing client
        at a new <code>base_url</code>.
      </p>
      <div class="hero__cta">
        <a class="hero__button" href="#quickstart">Try it →</a>
        <a class="hero__button hero__button--ghost" href={`${base}architecture/`}>Read the architecture</a>
      </div>
    </div>
    <div class="hero__visual">
      <FlowDiagram />
    </div>
  </section>

  <section class="section">
    <h2>How it works</h2>
    <ol class="steps">
      <li>
        Your client sends a normal <code>POST /{"{provider}"}/v1/embeddings</code> request to
        Zerocache instead of the real provider.
      </li>
      <li>
        Zerocache derives a content-addressed key from your forwarded API key, the provider, model,
        and text.
      </li>
      <li>
        Anything already in the store returns instantly. Anything new is batched to the real
        provider, using your key.
      </li>
      <li>New vectors are written back and returned in the original request order.</li>
      <li>
        Concurrent misses on the exact same text are coalesced into one upstream call, not one per
        request.
      </li>
    </ol>
  </section>

  <section class="section">
    <h2>Measured, not claimed</h2>
    <div class="stat-row">
      <StatCallout value="7 / 9" label="cache hits re-indexing an edited corpus" tone="hit" />
      <StatCallout value="983ms → 5ms" label="ingest latency, miss vs. hit" tone="hit" />
      <StatCallout value="7" label="embedding providers supported" tone="neutral" />
    </div>
    <p>
      Full methodology and all three consumer battle-tests on the
      <a href={`${base}benchmarks/`}>Benchmarks</a> page.
    </p>
  </section>

  <section class="section" id="quickstart">
    <h2>Try it</h2>
    <CodeBlock code={quickstart} lang="bash" />
  </section>
</BaseLayout>

<style>
  .hero {
    position: relative;
    overflow: hidden;
    padding: var(--space-6) 0 var(--space-5);
    display: grid;
    /* Without an explicit track, an implicit auto column sizes to its
       content's max-content width regardless of the container's own
       (definite) width, so a long paragraph like .hero__sub blows out
       past the viewport at narrow widths instead of wrapping. minmax(0, 1fr)
       caps the track at the available space so children can shrink/wrap. */
    grid-template-columns: minmax(0, 1fr);
    gap: var(--space-5);
    align-items: center;
  }
  @media (min-width: 900px) {
    .hero {
      grid-template-columns: minmax(0, 1.15fr) minmax(320px, 1fr);
    }
  }
  .hero::before {
    content: "";
    position: absolute;
    inset: 0;
    background: radial-gradient(ellipse 60% 50% at 20% 15%, var(--glow), transparent 70%);
    pointer-events: none;
  }
  .hero__copy {
    display: grid;
    gap: var(--space-3);
    align-content: start;
  }
  .hero h1 {
    font-size: clamp(2.25rem, 2.6vw + 1.75rem, 3.5rem);
    line-height: 1.08;
    margin: 0;
    max-width: 18ch;
  }
  .hero__sub {
    max-width: 48ch;
    font-size: 1.05rem;
    color: var(--muted);
  }
  .hero__cta {
    display: flex;
    gap: var(--space-3);
    flex-wrap: wrap;
    margin-top: var(--space-2);
  }
  .hero__button {
    font-family: var(--font-mono);
    font-size: 0.9rem;
    text-decoration: none;
    color: var(--ink);
    background: var(--rust);
    padding: var(--space-2) var(--space-3);
    border-radius: var(--radius);
    border: 1px solid var(--rust);
    transition:
      transform var(--duration-fast) var(--ease-standard),
      background var(--duration-fast) var(--ease-standard);
  }
  .hero__button:hover {
    transform: translateY(-1px);
  }
  .hero__button--ghost {
    color: var(--paper);
    background: transparent;
    border-color: var(--muted);
  }
  .hero__button--ghost:hover {
    border-color: var(--paper);
  }
  .hero__visual {
    align-self: center;
    padding: var(--space-4);
    border: var(--hairline);
    border-radius: calc(var(--radius) * 2);
    background: rgba(24, 22, 15, 0.5);
  }
  .hero__visual :global(.flow__controls) {
    justify-content: flex-start;
  }
  .steps {
    max-width: 60ch;
    padding-left: 1.2em;
  }
  .steps li {
    margin-bottom: var(--space-2);
  }
  .stat-row {
    display: flex;
    gap: var(--space-5);
    flex-wrap: wrap;
    margin: var(--space-3) 0;
  }
</style>

<script>
  import gsap from "gsap";

  const reduceMotion = window.matchMedia("(prefers-reduced-motion: reduce)").matches;
  if (!reduceMotion) {
    gsap.timeline({ defaults: { ease: "power3.out" } })
      .from(".hash-strip", { opacity: 0, y: 10, duration: 0.45 })
      .from(".hero h1", { opacity: 0, y: 18, duration: 0.6 }, "-=0.25")
      .from(".hero__sub", { opacity: 0, y: 12, duration: 0.5 }, "-=0.35")
      .from(".hero__cta a", { opacity: 0, y: 10, duration: 0.4, stagger: 0.08 }, "-=0.3")
      .from(".hero__visual", { opacity: 0, y: 16, duration: 0.6 }, "-=0.35");
  }
</script>
